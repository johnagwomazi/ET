PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/events
# Optional comma-separated resolver override for local SRV lookup issues only.
DNS_SERVERS=

JWT_ACCESS_SECRET=replace-with-a-strong-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-strong-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REQUIRE_EMAIL_VERIFICATION=true

COOKIE_HTTP_ONLY=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

SUPER_ADMIN_FIRST_NAME=John
SUPER_ADMIN_LAST_NAME=Agwom
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password

FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
EVENT_OPERATIONS_RATE_LIMIT_MAX=600
FINANCE_MUTATION_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_MAX=10
PAYMENT_MUTATION_RATE_LIMIT_MAX=10
NOTIFICATION_WORKER_ENABLED=true

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM="Events Platform <onboarding@resend.dev>"

PAYSTACK_SECRET_KEY=
PAYSTACK_MODE=test
PAYSTACK_TIMEOUT_MS=10000
